# Copy this file to .env.local and fill in your Supabase project's values.
# Find these in your Supabase project: Settings -> API.

# Project URL, e.g. https://xxxxxxxx.supabase.co
SUPABASE_URL=

# The "service_role" secret key (NOT the anon/public key).
# This app only ever uses the service-role key from server-side code
# (Next.js server actions) -- it is never sent to the browser. Keep it secret.
SUPABASE_SERVICE_ROLE_KEY=
